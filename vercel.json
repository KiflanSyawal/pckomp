{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/database/(.*)",
      "status": 403
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
